# ===== Straitbot FMS 后端配置(示例) =====
# 复制为 .env 后修改。详见 README。

HOST=0.0.0.0
PORT=8000
JWT_SECRET=straitbot-fms-please-change-this-secret-in-production-2026
DEFAULT_ENGINEER_USER=admin
DEFAULT_ENGINEER_PASS=admin
DEFAULT_OPERATOR_USER=operator
DEFAULT_OPERATOR_PASS=operator
POLL_STATUS_INTERVAL_SEC=10
POLL_META_INTERVAL_SEC=60
SSH_CONNECT_TIMEOUT=8
SSH_CMD_TIMEOUT=40
ROBOT_API_TIMEOUT=5.0
DEFAULT_LOG_RETENTION_DAYS=30
